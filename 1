/* 아이보리 톤 카드 이미지가 보라색 배경과 자연스럽게 이어지도록
   카드 뒤에 은은한 보라+골드 후광을 깔아준다 */
.card-frame::before {
  content: "";
  position: absolute;
  inset: -20%;
  background: radial-gradient(circle,
    rgba(142, 95, 213, 0.40) 0%,
    rgba(215, 172, 97, 0.22) 45%,
    transparent 72%);
  filter: blur(20px);
  z-index: -1;
  pointer-events: none;
}

/* 뒤집기 체크박스는 화면에서 숨기되 키보드 포커스는 살려둔다 */
.card-toggle {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* 카드 전체가 클릭 영역 */
.card-flip {
  display: block;
  width: 100%;
  height: 100%;
  cursor: pointer;
  border-radius: 18px;
  -webkit-tap-highlight-color: transparent;
}

.card-inner {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  transition: transform 160ms ease-in;
  transform: scaleX(1);
}

.card-face {
  position: absolute;
  inset: 0;
  display: block;
  border-radius: 18px;
  backface-visibility: hidden;
}

/* ===== 순수 CSS 뒤집기 (자바스크립트 불필요) =====
   기본: 뒷면이 보인다.  체크되면(클릭): 앞면이 보인다. */
.card-face--front { display: none; }
.card-face--back  { display: block; }

.card-toggle:checked ~ .card-frame .card-face--front { display: block; }
.card-toggle:checked ~ .card-frame .card-face--back  { display: none; }

/* 클릭 순간 카드가 가로로 얇아졌다 펴지며 넘어가는 느낌 (CSS만으로) */
.card-flip:active .card-inner {
  transform: scaleX(0.9);
}

/* 클릭을 유도하는 아주 은은한 숨쉬기 효과 (뒤집기 전, 뒷면일 때만) */
.card-toggle:not(:checked) ~ .card-frame .card-face--back {
  animation: cardBreathe 3.6s ease-in-out infinite;
}

/* 키보드 포커스 표시 */
.card-toggle:focus-visible ~ .card-frame .card-flip {
  outline: 2px solid var(--gold-light);
  outline-offset: 4px;
}

@keyframes cardBreathe {
  0%, 100% { filter: brightness(1); }
  50%      { filter: brightness(1.09); }
}

.card-image {
